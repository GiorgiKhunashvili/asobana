{
  "expo": {
    "name": "Asobana",
    "slug": "geowords",
    "version": "1.0.0",
    "scheme": "asobana",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ge.spilogames.asobana",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ge.spilogames.asobana"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8935292332039677~9321375605",
          "iosAppId": "ca-app-pub-8935292332039677~8334673550",
          "delayAppMeasurementInit": true
        }
      ],
      "./plugins/withUnityAds.js",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/"
        }
      ],
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#120C24",
          "image": "./assets/branding/splash-lockup.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/branding/mark-splash.png",
            "imageWidth": 160
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99b3845a-54a7-4cdc-9a58-1fcd9a5ac298"
      }
    },
    "owner": "gkhunashvili",
    "icon": "./assets/icon.png"
  }
}
