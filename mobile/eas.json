{
  "cli": {
    "version": ">=21.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "beta": {
      "extends": "production",
      "env": {
        "ASOBANA_LIVE_ADS": "0"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "ASOBANA_LIVE_ADS": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6825282360",
        "appleTeamId": "J5L83L4UNV"
      }
    }
  }
}
