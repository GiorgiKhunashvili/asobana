{
  "name": "asobana-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run start -w mobile",
    "ios": "npm run ios -w mobile",
    "android": "npm run android -w mobile",
    "test": "npm run test -w mobile",
    "typecheck": "npm run typecheck -w mobile",
    "lint": "npm run lint -w mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:python": "cd puzzle-generator && uv run pytest",
    "generate": "cd puzzle-generator && uv run python -m asobana_generator",
    "validate:content": "npm run validate:content -w mobile",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate:content && npm run format:check"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
